# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toyota_backend?schema=public"

# Static bearer token for API auth — generate with `openssl rand -hex 32`
API_TOKEN="replace-me-with-a-32-byte-random-hex"

# Anthropic Claude API key for /ai/ask endpoint
ANTHROPIC_API_KEY="sk-ant-..."

# HTTP port
PORT=3000

NODE_ENV=development
