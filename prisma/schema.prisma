// Toyota Ontario sales-rep catalog schema.
// See /root/.claude/plans/what-s-up-claude-we-enumerated-creek.md for design notes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PowertrainType {
  GAS
  HYBRID
  PHEV
  BEV
}

enum WarrantyCoverageType {
  BASIC
  POWERTRAIN
  HYBRID_COMPONENT
  HYBRID_BATTERY
  CORROSION_PERFORATION
  EMISSIONS
  ACCESSORIES
  ROADSIDE
}

enum FinanceProductCategory {
  EXTENDED_WARRANTY
  TIRE_RIM
  APPEARANCE
  PPF
  GAP
  KEY_REPLACEMENT
  UNDERCOATING
  OTHER
}

enum RepNoteScope {
  MODEL
  TRIM
  GLOBAL
  COMPETITOR
}

enum ScrapeRunStatus {
  PENDING_REVIEW
  APPLIED
  REJECTED
}

enum ScrapeDiffDecision {
  PENDING
  ACCEPT
  REJECT
}

enum BodyColorType {
  STANDARD
  METALLIC
  PEARL
  TWO_TONE
}

enum ConversationRole {
  USER
  ASSISTANT
}

enum FinancePromoKind {
  FINANCE
  LEASE
}

enum IncentiveKind {
  LOYALTY
  CONQUEST
  CASH_REBATE
  FINANCE_RATE
  LEASE_RATE
  STUDENT_GRAD
  MILITARY
  FIRST_RESPONDER
  OTHER
}

enum CustomerStatus {
  LEAD
  TEST_DRIVE_BOOKED
  QUOTED
  NEGOTIATING
  SOLD
  LOST
  FOLLOW_UP
}

enum CustomerInteractionKind {
  CALL
  EMAIL
  TEXT
  IN_PERSON
  TEST_DRIVE
  QUOTE_SENT
  NOTE
}

model Model {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  name       String
  make       String   @default("Toyota")
  bodyStyle  String?  @map("body_style")
  segment    String?
  notesMd    String?  @map("notes_md")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  trims      Trim[]
  warranties WarrantyCoverage[]

  @@index([make])
  @@map("models")
}

model Powertrain {
  id                    Int            @id @default(autoincrement())
  type                  PowertrainType
  displayName           String         @map("display_name")
  engineDesc            String?        @map("engine_desc")
  horsepowerHp          Int?           @map("horsepower_hp")
  torqueLbft            Int?           @map("torque_lbft")
  transmission          String?
  drivetrain            String?
  batteryKwh            Decimal?       @map("battery_kwh") @db.Decimal(5, 2)
  electricRangeKm       Int?           @map("electric_range_km")
  fuelEconomyCityL100   Decimal?       @map("fuel_economy_city_l100") @db.Decimal(4, 1)
  fuelEconomyHwyL100    Decimal?       @map("fuel_economy_hwy_l100") @db.Decimal(4, 1)
  fuelEconomyCombL100   Decimal?       @map("fuel_economy_comb_l100") @db.Decimal(4, 1)

  trims                 Trim[]

  @@map("powertrains")
}

model Trim {
  id              Int      @id @default(autoincrement())
  modelId         Int      @map("model_id")
  powertrainId    Int      @map("powertrain_id")
  year            Int
  name            String
  slug            String   @unique
  msrpCad         Decimal  @map("msrp_cad") @db.Decimal(10, 2)
  notesMd         String?  @map("notes_md")
  towRatingLbs    Int?     @map("tow_rating_lbs")
  payloadLbs      Int?     @map("payload_lbs")
  gvwrLbs         Int?     @map("gvwr_lbs")
  previousTrimId  Int?     @unique @map("previous_trim_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  model           Model       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  powertrain      Powertrain  @relation(fields: [powertrainId], references: [id])
  previousTrim    Trim?       @relation("TrimLineage", fields: [previousTrimId], references: [id])
  nextTrim        Trim?       @relation("TrimLineage")
  fees            Fee[]
  colors          TrimColor[]
  options         TrimOption[]
  promos          FinancePromo[]
  customers       Customer[]

  @@unique([modelId, year, name, powertrainId])
  @@index([year])
  @@index([modelId, year])
  @@map("trims")
}

model Fee {
  id                  Int       @id @default(autoincrement())
  trimId              Int       @map("trim_id")
  freightPdiCad       Decimal?  @map("freight_pdi_cad") @db.Decimal(10, 2)
  acExciseCad         Decimal?  @map("ac_excise_cad") @db.Decimal(10, 2)
  omvicFeeCad         Decimal?  @map("omvic_fee_cad") @db.Decimal(10, 2)
  tireStewardshipCad  Decimal?  @map("tire_stewardship_cad") @db.Decimal(10, 2)
  dealerAdminCad      Decimal?  @map("dealer_admin_cad") @db.Decimal(10, 2)
  otherFeesJson       Json?     @map("other_fees_json")
  hstRate             Decimal   @default(0.13) @map("hst_rate") @db.Decimal(4, 3)
  effectiveDate       DateTime  @map("effective_date") @db.Date

  trim                Trim      @relation(fields: [trimId], references: [id], onDelete: Cascade)

  @@unique([trimId, effectiveDate])
  @@map("fees")
}

model WarrantyCoverage {
  id                     Int                  @id @default(autoincrement())
  modelId                Int                  @map("model_id")
  year                   Int
  coverageType           WarrantyCoverageType @map("coverage_type")
  durationMonths         Int?                 @map("duration_months")
  distanceKm             Int?                 @map("distance_km")
  appliesToPowertrains   PowertrainType[]     @map("applies_to_powertrains")
  descriptionMd          String?              @map("description_md")
  sourceUrl              String?              @map("source_url")

  model                  Model                @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, year, coverageType])
  @@index([modelId, year])
  @@map("warranty_coverages")
}

model FinanceProduct {
  id                    Int                    @id @default(autoincrement())
  slug                  String                 @unique
  name                  String
  category              FinanceProductCategory
  descriptionMd         String?                @map("description_md")
  pricingNotes          String?                @map("pricing_notes")
  termOptionsJson       Json?                  @map("term_options_json")
  eligiblePowertrains   PowertrainType[]       @map("eligible_powertrains")
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@map("finance_products")
}

model RepNote {
  id         Int          @id @default(autoincrement())
  scopeType  RepNoteScope @map("scope_type")
  scopeId    Int?         @map("scope_id")
  title      String
  bodyMd     String       @map("body_md")
  tags       String[]
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([scopeType, scopeId])
  @@map("rep_notes")
}

model ScrapeRun {
  id           Int             @id @default(autoincrement())
  startedAt    DateTime        @default(now()) @map("started_at")
  finishedAt   DateTime?       @map("finished_at")
  source       String
  status       ScrapeRunStatus @default(PENDING_REVIEW)
  summaryJson  Json?           @map("summary_json")

  diffs        ScrapeDiff[]

  @@map("scrape_runs")
}

model ScrapeDiff {
  id         Int                @id @default(autoincrement())
  runId      Int                @map("run_id")
  tableName  String             @map("table_name")
  recordPk   String             @map("record_pk")
  field      String
  oldValue   String?            @map("old_value")
  newValue   String?            @map("new_value")
  decision   ScrapeDiffDecision @default(PENDING)

  run        ScrapeRun          @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("scrape_diffs")
}

model BodyColor {
  id                Int             @id @default(autoincrement())
  slug              String          @unique
  name              String
  hex               String?
  type              BodyColorType   @default(STANDARD)
  notesMd           String?         @map("notes_md")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  trimAvailability  TrimColor[]

  @@map("body_colors")
}

model TrimColor {
  id                 Int        @id @default(autoincrement())
  trimId             Int        @map("trim_id")
  bodyColorId        Int        @map("body_color_id")
  available          Boolean    @default(true)
  premiumChargeCad   Decimal?   @map("premium_charge_cad") @db.Decimal(10, 2)
  notesMd            String?    @map("notes_md")

  trim               Trim       @relation(fields: [trimId], references: [id], onDelete: Cascade)
  bodyColor          BodyColor  @relation(fields: [bodyColorId], references: [id], onDelete: Cascade)

  @@unique([trimId, bodyColorId])
  @@index([trimId])
  @@index([bodyColorId])
  @@map("trim_colors")
}

model Conversation {
  id          Int                   @id @default(autoincrement())
  title       String?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  messages    ConversationMessage[]

  @@map("conversations")
}

model ConversationMessage {
  id                  Int               @id @default(autoincrement())
  conversationId      Int               @map("conversation_id")
  role                ConversationRole
  content             String
  modelUsed           String?           @map("model_used")
  citationsJson       Json?             @map("citations_json")
  cachedInputTokens   Int?              @map("cached_input_tokens")
  uncachedInputTokens Int?              @map("uncached_input_tokens")
  outputTokens        Int?              @map("output_tokens")
  createdAt           DateTime          @default(now()) @map("created_at")

  conversation        Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_messages")
}

model OptionPackage {
  id           Int          @id @default(autoincrement())
  slug         String       @unique
  name         String
  descriptionMd String?     @map("description_md")
  featuresJson Json?        @map("features_json")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  trimOptions  TrimOption[]

  @@map("option_packages")
}

model TrimOption {
  id              Int           @id @default(autoincrement())
  trimId          Int           @map("trim_id")
  optionPackageId Int           @map("option_package_id")
  priceCad        Decimal?      @map("price_cad") @db.Decimal(10, 2)
  available       Boolean       @default(true)
  required        Boolean       @default(false)
  notesMd         String?       @map("notes_md")

  trim            Trim          @relation(fields: [trimId], references: [id], onDelete: Cascade)
  optionPackage   OptionPackage @relation(fields: [optionPackageId], references: [id], onDelete: Cascade)

  @@unique([trimId, optionPackageId])
  @@index([trimId])
  @@index([optionPackageId])
  @@map("trim_options")
}

model FinancePromo {
  id                 Int              @id @default(autoincrement())
  trimId             Int?             @map("trim_id")
  modelSlug          String?          @map("model_slug")
  kind               FinancePromoKind
  termMonths         Int              @map("term_months")
  aprPercent         Decimal?         @map("apr_percent") @db.Decimal(5, 3)
  moneyFactor        Decimal?         @map("money_factor") @db.Decimal(7, 5)
  residualPercent    Decimal?         @map("residual_percent") @db.Decimal(5, 2)
  effectiveFrom      DateTime         @map("effective_from") @db.Date
  effectiveTo        DateTime?        @map("effective_to") @db.Date
  notesMd            String?          @map("notes_md")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  trim               Trim?            @relation(fields: [trimId], references: [id], onDelete: Cascade)

  @@index([trimId])
  @@index([modelSlug])
  @@index([effectiveFrom, effectiveTo])
  @@map("finance_promos")
}

model Incentive {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  name            String
  kind            IncentiveKind
  amountCad       Decimal?      @map("amount_cad") @db.Decimal(10, 2)
  stackable       Boolean       @default(true)
  eligibleMakes   String[]      @map("eligible_makes")
  eligibleSlugs   String[]      @map("eligible_slugs")
  eligibleYears   Int[]         @map("eligible_years")
  effectiveFrom   DateTime      @map("effective_from") @db.Date
  effectiveTo     DateTime?     @map("effective_to") @db.Date
  notesMd         String?       @map("notes_md")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([effectiveFrom, effectiveTo])
  @@index([active])
  @@map("incentives")
}

model MaintenanceInterval {
  id              Int       @id @default(autoincrement())
  modelSlug       String?   @map("model_slug")
  powertrainType  String?   @map("powertrain_type")
  intervalKm      Int       @map("interval_km")
  servicesJson    Json      @map("services_json")
  partsCostCad    Decimal?  @map("parts_cost_cad") @db.Decimal(10, 2)
  labourMinutes   Int?      @map("labour_minutes")
  notesMd         String?   @map("notes_md")

  @@index([modelSlug, intervalKm])
  @@map("maintenance_intervals")
}

model Customer {
  id              Int        @id @default(autoincrement())
  name            String
  email           String?
  phone           String?
  status          CustomerStatus @default(LEAD)
  vehicleOfInterestTrimId Int? @map("vehicle_of_interest_trim_id")
  followUpDate    DateTime?  @map("follow_up_date") @db.Date
  budgetCad       Decimal?   @map("budget_cad") @db.Decimal(10, 2)
  notesMd         String?    @map("notes_md")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  vehicleOfInterest Trim?    @relation(fields: [vehicleOfInterestTrimId], references: [id], onDelete: SetNull)
  interactions    CustomerInteraction[]

  @@index([status])
  @@index([followUpDate])
  @@map("customers")
}

model CustomerInteraction {
  id          Int                       @id @default(autoincrement())
  customerId  Int                       @map("customer_id")
  kind        CustomerInteractionKind
  bodyMd      String                    @map("body_md")
  createdAt   DateTime                  @default(now()) @map("created_at")

  customer    Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_interactions")
}

// Single-row table used to invalidate the AI prompt cache when the catalog changes.
model Meta {
  id              Int      @id @default(1)
  catalogVersion  Int      @default(1) @map("catalog_version")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("meta")
}
